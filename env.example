SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
APP_URL=http://127.0.0.1:3000
SESSION_SECRET=replace-with-a-long-random-string

# Optional — enables "Upload a poster to auto-add artists" on the lineup
# builder. Without this set, that button shows a message explaining it's not
# configured rather than failing silently. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=

# Optional — enables the "Setlist" filter, which pulls each artist's
# recently-played songs from setlist.fm instead of just Spotify's own
# relevance ranking. Without this set, that filter silently falls back to
# "Most popular" only rather than erroring. Free to get, but requires
# registering an account and applying for a key at setlist.fm/settings/api.
SETLISTFM_API_KEY=
